# Aegis website: error page, and keep build sources and repo files off the web
ErrorDocument 404 /404.html
Options -Indexes
RedirectMatch 404 ^/(_src|_work|\.git)(/|$)
# Hidden for now (client confidentiality). Restore steps are in README.md.
RedirectMatch 404 ^/track-record\.html$
RedirectMatch 404 ^/assets/clients(/|$)
<FilesMatch "^(README\.md|\.gitignore|\.gitattributes)$">
  Require all denied
</FilesMatch>

# Hotlink protection: other websites cannot embed our photos and logos.
# Visits with no referrer (typing the address, some privacy browsers) are still allowed.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)*aegiscomm\.com\.my/ [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?google\.[a-z.]+/ [NC]
  RewriteRule ^assets/(photos|team|clients|network)/.+\.(jpe?g|png|webp)$ - [F,NC]
</IfModule>
